diff --git a/crates/gpui/src/frame_trace.rs b/crates/gpui/src/frame_trace.rs
new file mode 100644
index 0000000..c03d929
--- /dev/null
+++ b/crates/gpui/src/frame_trace.rs
@@ -0,0 +1,114 @@
+//! Scratch instrumentation (not for main): with `CAP_FRAME_TRACE` set, counts
+//! what wakes each window's frames and prints a summary to stderr every 5 s.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+static ENABLED: OnceLock<bool> = OnceLock::new();
+
+pub(crate) fn enabled() -> bool {
+    *ENABLED.get_or_init(|| std::env::var_os("CAP_FRAME_TRACE").is_some())
+}
+
+struct State {
+    started: Instant,
+    counts: HashMap<(u64, &'static str, String), u64>,
+    calls: HashMap<&'static str, u64>,
+}
+
+thread_local! {
+    static STATE: RefCell<State> = RefCell::new(State {
+        started: Instant::now(),
+        counts: HashMap::new(),
+        calls: HashMap::new(),
+    });
+}
+
+fn condensed_backtrace() -> String {
+    let text = format!("{}", std::backtrace::Backtrace::force_capture());
+    let mut frames: Vec<(String, String)> = Vec::new();
+    let mut lines = text.lines().peekable();
+    while let Some(line) = lines.next() {
+        let trimmed = line.trim();
+        let Some((_, symbol)) = trimmed.split_once(": ") else {
+            continue;
+        };
+        let mut at = String::new();
+        if let Some(next) = lines.peek()
+            && next.trim().starts_with("at ")
+        {
+            at = next.trim().trim_start_matches("at ").to_string();
+            lines.next();
+        }
+        frames.push((symbol.to_string(), at));
+    }
+    let is_app = |symbol: &str| symbol.starts_with("cap_") || symbol.starts_with("<cap_");
+    let mut picked: Vec<String> = frames
+        .iter()
+        .filter(|(symbol, _)| is_app(symbol))
+        .take(4)
+        .map(|(symbol, at)| format!("{symbol} @ {}", short_path(at)))
+        .collect();
+    if picked.is_empty() {
+        picked = frames
+            .iter()
+            .filter(|(symbol, _)| {
+                !(symbol.starts_with("std::")
+                    || symbol.starts_with("core::")
+                    || symbol.starts_with("alloc::")
+                    || symbol.contains("backtrace")
+                    || symbol.contains("frame_trace"))
+            })
+            .take(6)
+            .map(|(symbol, at)| format!("{symbol} @ {}", short_path(at)))
+            .collect();
+    }
+    picked.join(" <- ")
+}
+
+fn short_path(at: &str) -> String {
+    let at = at.replace('\\', "/");
+    for marker in ["/src/", "/crates/"] {
+        if let Some(index) = at.rfind(marker) {
+            let start = at[..index].rfind('/').map(|i| i + 1).unwrap_or(0);
+            return at[start..].to_string();
+        }
+    }
+    at
+}
+
+/// `key: None` keys the call by a condensed backtrace, sampled one call in 4.
+pub(crate) fn record(window: u64, kind: &'static str, key: Option<String>) {
+    if !enabled() {
+        return;
+    }
+    STATE.with(|state| {
+        let mut state = state.borrow_mut();
+        let call = {
+            let entry = state.calls.entry(kind).or_insert(0);
+            *entry += 1;
+            *entry
+        };
+        let key = match key {
+            Some(key) => key,
+            None if call % 4 == 1 => condensed_backtrace(),
+            None => "(unsampled)".to_string(),
+        };
+        *state.counts.entry((window, kind, key)).or_insert(0) += 1;
+        if state.started.elapsed() >= Duration::from_secs(5) {
+            let elapsed = state.started.elapsed().as_secs_f64();
+            let mut rows: Vec<_> = state.counts.drain().collect();
+            rows.sort_by(|a, b| b.1.cmp(&a.1));
+            for ((window, kind, key), count) in rows.into_iter().take(40) {
+                eprintln!(
+                    "FRAMETRACE window={window} kind={kind} per_s={:.2} key={key}",
+                    count as f64 / elapsed
+                );
+            }
+            eprintln!("FRAMETRACE ---");
+            state.started = Instant::now();
+        }
+    });
+}
